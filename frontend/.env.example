# Origin of the Laravel API.
#
# In local development the API and this app both sit on `localhost`. Cookies
# ignore port numbers, so localhost:8010 and localhost:3000 share the session
# cookie with no hosts-file entries required.
#
# In production both must sit on sibling subdomains of one parent domain:
#   NEXT_PUBLIC_API_URL=https://api.opsight.com
#
# NOTE: NEXT_PUBLIC_* values are embedded in the browser bundle and are public
# by definition. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8010

# With no domain of one's own (the public demo on Vercel's addresses), the app
# forwards /api/v1 and /sanctum to the API itself (next.config.mjs). Then
# NEXT_PUBLIC_API_URL is this app's own address and API_ORIGIN the API's.
# API_ORIGIN is server-side only and never reaches the browser.
#   NEXT_PUBLIC_API_URL=https://opsight-demo.vercel.app
#   API_ORIGIN=https://opsight-demo-api.vercel.app
# API_ORIGIN=

# One-click sign-in with the demo accounts on the sign-in page. The public
# demo only.
# NEXT_PUBLIC_DEMO_MODE=true

# Renders the development-only component gallery at /gallery.
# Never set in a real deployment.
NEXT_PUBLIC_ENABLE_GALLERY=true
