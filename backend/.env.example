APP_NAME=Opsight
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

# The application always runs in UTC. Business date boundaries are resolved in
# business_settings.timezone, never here. See docs/database/METRICS.md §1.2.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opsight
DB_USERNAME=root
DB_PASSWORD=

# Tests run against a REAL MySQL/MariaDB schema, never SQLite.
# See docs/architecture/TESTING_STRATEGY.md §3.
DB_TEST_DATABASE=opsight_test

# ---------------------------------------------------------------------------
# Session & Sanctum (SPA cookie authentication — ADR-002)
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
#   Cookies ignore port numbers, so localhost:8010 (API) and localhost:3000
#   (frontend) share a session cookie with no hosts-file entries required.
#     SESSION_DOMAIN=localhost
#     SANCTUM_STATEFUL_DOMAINS=localhost:3000
#
# PRODUCTION
#   Frontend and API must sit on sibling subdomains of one parent domain:
#     SESSION_DOMAIN=.opsight.com
#     SANCTUM_STATEFUL_DOMAINS=app.opsight.com
#     SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Three years of realistic orders, customers and expenses, on top of the four
# accounts. Opt-in, because a real installation must not arrive pre-populated
# with invented history (DatabaseSeeder).
SEED_DEMO_DATA=false

# Behind a proxy or CDN, the addresses that may set X-Forwarded-For — a comma
# separated list, or * to trust whatever sits in front. Empty means the API is
# reached directly, and no forwarded header is believed.
TRUSTED_PROXIES=

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Origin allowed to send credentialed cross-origin requests.
# Wildcards are incompatible with credentials and are never used.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Queue & cache — database driver for the MVP (ADR-011)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@opsight.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
