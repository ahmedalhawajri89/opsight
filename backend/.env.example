APP_NAME=Baydar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

# The application always runs in UTC. Business date boundaries are resolved in
# business_settings.timezone, never here. See docs/database/METRICS.md §1.2.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=opsight
DB_USERNAME=root
DB_PASSWORD=

# Tests run against a REAL MySQL/MariaDB schema, never SQLite.
# See docs/architecture/TESTING_STRATEGY.md §3.
DB_TEST_DATABASE=opsight_test
# The connection keeps UTC, as the application does (config/database.php).
# DB_TIMEZONE=+00:00

# ---------------------------------------------------------------------------
# Session & Sanctum (SPA cookie authentication — ADR-002)
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
#   Cookies ignore port numbers, so localhost:8010 (API) and localhost:3000
#   (frontend) share a session cookie with no hosts-file entries required.
#     SESSION_DOMAIN=localhost
#     SANCTUM_STATEFUL_DOMAINS=localhost:3000
#
# PRODUCTION
#   Frontend and API must sit on sibling subdomains of one parent domain:
#     SESSION_DOMAIN=.opsight.com
#     SANCTUM_STATEFUL_DOMAINS=app.opsight.com
#     SESSION_SECURE_COOKIE=true
#
# BEHIND THE FRONTEND'S PROXY (no domain of one's own, docs/DEPLOYMENT.md)
#   The browser only sees the frontend's origin, so the cookie is its own:
#     SESSION_DOMAIN unset
#     SANCTUM_STATEFUL_DOMAINS=<the frontend's host>
#     SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Three years of realistic orders, customers and expenses, on top of the four
# accounts. Opt-in, because a real installation must not arrive pre-populated
# with invented history (DatabaseSeeder).
SEED_DEMO_DATA=false

# The public demo, and nowhere else (config/demo.php, docs/DEPLOYMENT.md): seeds
# the demo data in production, keeps the demo accounts unchangeable and lets
# `demo:reset` restore the snapshot every night.
DEMO_MODE=false

# Behind a proxy or CDN, the addresses that may set X-Forwarded-For — a comma
# separated list, or * to trust whatever sits in front. Empty means the API is
# reached directly, and no forwarded header is believed.
TRUSTED_PROXIES=

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Origin allowed to send credentialed cross-origin requests.
# Wildcards are incompatible with credentials and are never used.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Queue & cache — database driver for the MVP (ADR-011)
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The queue is real from Phase 5 on: a webhook delivery is stored, answered,
# and handled by a worker (ADR-027). `php artisan queue:work` must be running,
# or deliveries pile up unprocessed and nothing says so.
QUEUE_CONNECTION=database

# Signing secrets for webhook deliveries. A provider with no secret here is a
# 404, whatever is registered in config/integrations.php — so an installation
# that has not connected a store has no endpoint accepting payloads for one.
SALLA_WEBHOOK_SECRET=
# From the Salla Partners dashboard. Without them a connected store's tokens
# can never be refreshed, and every connection dies after a fortnight.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# Zid (ADR-037). The redirect URI is the frontend's callback page and must
# match the app's Redirection URL in Zid's Partner Dashboard exactly, e.g.
# http://localhost:3000/settings/integrations/zid/callback
# ZID_WEBHOOK_SECRET is the Basic Auth password Zid sends back on every
# delivery; without it no webhooks are registered and the door is a 404.
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_REDIRECT_URI=
ZID_WEBHOOK_SECRET=
ZID_WEBHOOK_URL=

# Ask Baydar (ADR-038). Without a key the assistant answers 503 and the screen
# says it is not set up. The model defaults to Claude Opus 5.5.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_MONTHLY_TOKENS=2000000

# The morning brief (phase C). Email needs only working mail. WhatsApp needs
# Meta's Cloud API and an approved template (docs/SETUP.md); without the two
# values below the WhatsApp option is shown, disabled, with the reason.
BRIEF_HOUR=8
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BRIEF_TEMPLATE=baydar_morning_brief

WEBHOOK_MAX_PAYLOAD_KB=512
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@opsight.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sign in with Google (optional). The OAuth 2.0 Client ID of a "Web
# application" client in Google Cloud Console, with the frontend's address
# listed under Authorised JavaScript origins. Leave empty to turn it off.
# The frontend needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
