# A local crib sheet of demo logins. Kept out of the repository on purpose:
# a file called CREDENTIALS.txt is a bad look even when its contents are not
# secret.
CREDENTIALS.txt

# Throwaway scripts used while building a screen.
*.tmp.mjs

# Saved Playwright sessions are real credentials.
frontend/playwright/.auth/

# ---------- Generic ----------
node_modules/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
